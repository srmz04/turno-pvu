{
  "name": "turno-pvu-backend",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Turnos para Puestos de Vacunación Universal - Backend",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --config wrangler.staging.toml",
    "deploy:prod": "wrangler deploy --config wrangler.prod.toml",
    "db:create": "wrangler d1 create turno-pvu-db",
    "db:migrate": "wrangler d1 execute turno-pvu-db --file=schema.sql",
    "db:seed": "wrangler d1 execute turno-pvu-db --file=seed.sql",
    "db:reset": "bash scripts/reset-db.sh",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "bash scripts/run-tests.sh local",
    "test:e2e:dev": "bash scripts/run-tests.sh dev",
    "test:e2e:staging": "bash scripts/run-tests.sh staging",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "cloudflare-workers",
    "vaccination",
    "health",
    "turno"
  ],
  "author": "TURNO-PVU Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240129.0",
    "wrangler": "^3.78.12",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0"
  }
}
